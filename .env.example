# OmniVault AI - Environment Configuration

# -----------------------------------------------------------------------------
# Blockchain / HashKey Chain Configuration
# -----------------------------------------------------------------------------
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133
ENABLE_MAINNET=false
HSK_MAINNET_RPC_URL=https://mainnet.hsk.xyz
HSK_MAINNET_CHAIN_ID=177

# -----------------------------------------------------------------------------
# HSKSwap Deployed Contracts (HashKey Testnet 133)
# -----------------------------------------------------------------------------
HSKSWAP_FACTORY_ADDRESS=0x2dC2c21D1049F786C535bF9d45F999dB5474f3A0
HSKSWAP_ROUTER_ADDRESS=0xa6914E66690c6794244B5f66a09eAEbf66254237
HSKSWAP_QUOTER_ADDRESS=0x73820d9eE5Bf1BfcD429580320FC7A374E8fa1cC
HSKSWAP_MULTICALL_ADDRESS=0x47F625Ec29637445AA1570d7008Cf78692CdA096

# Verified Testnet Tokens
TOKEN_WHSK_ADDRESS=0xCA8aAceEC5Db1e91B9Ed3a344bA026c4a2B3ebF6
TOKEN_USDT_ADDRESS=0x98B6173A8B7DFc52ce8bc88f1184a918A1CCaa4F
TOKEN_USDC_ADDRESS=0x18Ec8e93627c893ae61ae0491c1C98769FD4Dfa2

# -----------------------------------------------------------------------------
# Application & Execution Modes
# -----------------------------------------------------------------------------
# Options: 'paper' (simulated execution) or 'testnet' (on-chain testnet execution)
EXECUTION_MODE=paper

# Automated Testnet Signer (Optional: only needed if running autonomous on-chain execution)
# NEVER commit private keys or use real funds!
TESTNET_SIGNER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# AI / LLM Configuration (OpenRouter / OpenAI compatible)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Database Configuration
# Defaults to local SQLite for zero-prerequisite setup, or use PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./omnivault.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omnivault

# -----------------------------------------------------------------------------
# Server & CORS
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
